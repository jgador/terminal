<Window x:Class="AgentDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="AgentDock"
        Width="1360"
        Height="860"
        MinWidth="980"
        MinHeight="620"
        Background="#050505"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        mc:Ignorable="d">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#050505" />
        <SolidColorBrush x:Key="CardBrush" Color="#0A0A0A" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#0F0F0F" />
        <SolidColorBrush x:Key="BorderBrushSubtle" Color="#161616" />
        <SolidColorBrush x:Key="BorderBrushHover" Color="#2A2A2A" />
        <SolidColorBrush x:Key="SelectedBorderBrush" Color="#313131" />
        <SolidColorBrush x:Key="TextBrush" Color="#B8B8B8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#767676" />
        <SolidColorBrush x:Key="SoftBrush" Color="#5B5B5B" />
        <SolidColorBrush x:Key="RunningBrush" Color="#56C98E" />
        <SolidColorBrush x:Key="IdleBrush" Color="#666666" />
        <SolidColorBrush x:Key="AttentionBrush" Color="#C9912C" />

        <LinearGradientBrush x:Key="FadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#050505" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="TerminalCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="0"
                                      Color="#000000"
                                      Opacity="0.34" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushHover}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="34"
                                              ShadowDepth="0"
                                              Color="#000000"
                                              Opacity="0.5" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedTerminalCardStyle" TargetType="Border" BasedOn="{StaticResource TerminalCardStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="34"
                                      ShadowDepth="0"
                                      Color="#000000"
                                      Opacity="0.58" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AttentionCardStyle" TargetType="Border" BasedOn="{StaticResource TerminalCardStyle}">
            <Setter Property="BorderBrush" Value="#4A3820" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="26"
                                      ShadowDepth="0"
                                      Color="#C9912C"
                                      Opacity="0.20" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#73531F" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="34"
                                              ShadowDepth="0"
                                              Color="#D59A31"
                                              Opacity="0.28" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TerminalViewportStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            <Setter Property="BorderBrush" Value="#141414" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PreviewTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="18,16,18,18" />
            <Setter Property="FontFamily" Value="Cascadia Code" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#8C8C8C" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#111111" />
            <Setter Property="BorderBrush" Value="#1A1A1A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Content" Value="Focus Active" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="Back to Overview" />
                    <Setter Property="Background" Value="#141414" />
                    <Setter Property="BorderBrush" Value="#303030" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161616" />
                    <Setter Property="BorderBrush" Value="#2E2E2E" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="#202020" />
                    <Ellipse Width="9" Height="9" Margin="7,0,0,0" Fill="#202020" />
                    <Ellipse Width="9" Height="9" Margin="7,0,0,0" Fill="#202020" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="34"
                        Height="34"
                        Margin="16,0,14,0"
                        Background="#101010"
                        BorderBrush="{StaticResource BorderBrushSubtle}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Code"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               Text=">_" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#E7E7E7"
                               Text="AgentDock" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Text="terminal multiplexer" />
                </StackPanel>

                <ToggleButton x:Name="ViewModeToggle"
                              Grid.Column="3"
                              Style="{StaticResource HeaderActionButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SurfaceColumn0" Width="*" />
                <ColumnDefinition x:Name="SurfaceColumnGap" Width="20" />
                <ColumnDefinition x:Name="SurfaceColumn1" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SurfaceRow0" Height="*" />
                <RowDefinition x:Name="SurfaceGap0" Height="20" />
                <RowDefinition x:Name="SurfaceRow1" Height="0" />
                <RowDefinition x:Name="SurfaceGap1" Height="0" />
                <RowDefinition x:Name="SurfaceRow2" Height="*" />
                <RowDefinition x:Name="SurfaceGap2" Height="0" />
                <RowDefinition x:Name="SurfaceRow3" Height="0" />
            </Grid.RowDefinitions>

            <Border x:Name="SidebarHeader"
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="16,12"
                    Visibility="Collapsed">
                <TextBlock Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="BACKGROUND SESSIONS" />
            </Border>

            <Border x:Name="SessionCard0"
                    Grid.Row="0"
                    Grid.Column="0"
                    PreviewMouseLeftButtonDown="SessionCard_PreviewMouseLeftButtonDown"
                    Style="{StaticResource SelectedTerminalCardStyle}"
                    Tag="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource HeaderBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="22,22,0,0"
                            Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SessionStatus0" Width="9" Height="9" Fill="{StaticResource RunningBrush}" />
                                <TextBlock x:Name="SessionTitle0" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#E5E5E5" FontSize="14" FontWeight="SemiBold" Text="PowerShell 01" />
                            </StackPanel>

                            <Border Grid.Column="1" Padding="10,4" Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="12">
                                <TextBlock x:Name="SessionBadge0" Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Code" FontSize="11" FontWeight="SemiBold" Text="active" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="16" Style="{StaticResource TerminalViewportStyle}">
                        <Grid ClipToBounds="True">
                            <Grid x:Name="SessionHost0" />
                            <Grid x:Name="PreviewPanel0">
                                <TextBlock x:Name="PreviewText0" Style="{StaticResource PreviewTextStyle}" Text="Starting PowerShell 01..." />
                                <Rectangle x:Name="SessionFade0" Height="84" VerticalAlignment="Bottom" Fill="{StaticResource FadeBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <DockPanel x:Name="SessionFooter0" Grid.Row="2" Margin="16,0,16,14" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource SoftBrush}" FontSize="12" Text="live session" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Foreground="#D0D0D0" FontFamily="Cascadia Code" FontSize="13" Text="&#x2588;" />
                            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="running" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border x:Name="SessionCard1"
                    Grid.Row="0"
                    Grid.Column="2"
                    PreviewMouseLeftButtonDown="SessionCard_PreviewMouseLeftButtonDown"
                    Style="{StaticResource AttentionCardStyle}"
                    Tag="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource HeaderBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="22,22,0,0"
                            Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SessionStatus1" Width="9" Height="9" Fill="{StaticResource AttentionBrush}" />
                                <TextBlock x:Name="SessionTitle1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#E5E5E5" FontSize="14" FontWeight="SemiBold" Text="PowerShell 02" />
                            </StackPanel>

                            <Border Grid.Column="1" Padding="10,4" Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="12">
                                <TextBlock x:Name="SessionBadge1" Foreground="{StaticResource AttentionBrush}" FontFamily="Cascadia Code" FontSize="11" FontWeight="SemiBold" Text="attention" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="16" Style="{StaticResource TerminalViewportStyle}">
                        <Grid ClipToBounds="True">
                            <Grid x:Name="SessionHost1" />
                            <Grid x:Name="PreviewPanel1">
                                <TextBlock x:Name="PreviewText1" Style="{StaticResource PreviewTextStyle}" Text="Starting PowerShell 02..." />
                                <Rectangle x:Name="SessionFade1" Height="84" VerticalAlignment="Bottom" Fill="{StaticResource FadeBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <DockPanel x:Name="SessionFooter1" Grid.Row="2" Margin="16,0,16,14" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource SoftBrush}" FontSize="12" Text="live session" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Foreground="#D0D0D0" FontFamily="Cascadia Code" FontSize="13" Text="&#x2588;" />
                            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="running" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border x:Name="SessionCard2"
                    Grid.Row="4"
                    Grid.Column="0"
                    PreviewMouseLeftButtonDown="SessionCard_PreviewMouseLeftButtonDown"
                    Style="{StaticResource TerminalCardStyle}"
                    Tag="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource HeaderBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="22,22,0,0"
                            Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SessionStatus2" Width="9" Height="9" Fill="{StaticResource RunningBrush}" />
                                <TextBlock x:Name="SessionTitle2" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#E5E5E5" FontSize="14" FontWeight="SemiBold" Text="PowerShell 03" />
                            </StackPanel>

                            <Border Grid.Column="1" Padding="10,4" Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="12">
                                <TextBlock x:Name="SessionBadge2" Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Code" FontSize="11" FontWeight="SemiBold" Text="running" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="16" Style="{StaticResource TerminalViewportStyle}">
                        <Grid ClipToBounds="True">
                            <Grid x:Name="SessionHost2" />
                            <Grid x:Name="PreviewPanel2">
                                <TextBlock x:Name="PreviewText2" Style="{StaticResource PreviewTextStyle}" Text="Starting PowerShell 03..." />
                                <Rectangle x:Name="SessionFade2" Height="84" VerticalAlignment="Bottom" Fill="{StaticResource FadeBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <DockPanel x:Name="SessionFooter2" Grid.Row="2" Margin="16,0,16,14" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource SoftBrush}" FontSize="12" Text="live session" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Foreground="#D0D0D0" FontFamily="Cascadia Code" FontSize="13" Text="&#x2588;" />
                            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="running" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border x:Name="SessionCard3"
                    Grid.Row="4"
                    Grid.Column="2"
                    PreviewMouseLeftButtonDown="SessionCard_PreviewMouseLeftButtonDown"
                    Style="{StaticResource TerminalCardStyle}"
                    Tag="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource HeaderBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="22,22,0,0"
                            Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SessionStatus3" Width="9" Height="9" Fill="{StaticResource RunningBrush}" />
                                <TextBlock x:Name="SessionTitle3" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#E5E5E5" FontSize="14" FontWeight="SemiBold" Text="PowerShell 04" />
                            </StackPanel>

                            <Border Grid.Column="1" Padding="10,4" Background="#111111" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="12">
                                <TextBlock x:Name="SessionBadge3" Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Code" FontSize="11" FontWeight="SemiBold" Text="running" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="16" Style="{StaticResource TerminalViewportStyle}">
                        <Grid ClipToBounds="True">
                            <Grid x:Name="SessionHost3" />
                            <Grid x:Name="PreviewPanel3">
                                <TextBlock x:Name="PreviewText3" Style="{StaticResource PreviewTextStyle}" Text="Starting PowerShell 04..." />
                                <Rectangle x:Name="SessionFade3" Height="84" VerticalAlignment="Bottom" Fill="{StaticResource FadeBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <DockPanel x:Name="SessionFooter3" Grid.Row="2" Margin="16,0,16,14" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource SoftBrush}" FontSize="12" Text="live session" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Foreground="#D0D0D0" FontFamily="Cascadia Code" FontSize="13" Text="&#x2588;" />
                            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="running" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

